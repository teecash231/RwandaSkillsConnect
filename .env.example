# Rwanda SkillsConnect — Environment Variables
# Copy this file to .env and fill in your values.
# For Vercel: add these as Environment Variables in the project settings.

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Flutterwave (for payments) ────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────
APP_URL=https://your-domain.vercel.app
